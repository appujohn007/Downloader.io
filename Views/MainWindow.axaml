<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DownloaderApp.ViewModels"
        xmlns:models="using:DownloaderApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="680"
        Width="1050" Height="680"
        MinWidth="820" MinHeight="520"
        x:Class="DownloaderApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Downloader.io">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="34, *" Background="{DynamicResource AppBgBrush}">
        <!-- ================= TOP WINDOWS CAPTION & TITLE BAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrushCustom}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <!-- App Title / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="downloader.io" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Live Stats (when downloading) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            IsVisible="{Binding TotalActiveCount}">
                    <TextBlock Text="{Binding TotalDownloadSpeedFormatted, StringFormat='{}↓ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalActiveCount, StringFormat='{}{0} active'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Theme Toggle Button -->
                <Button Grid.Column="2" Classes="ghost-btn" Command="{Binding ToggleThemeCommand}" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Toggle Theme">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                  Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
                        <TextBlock Text="{Binding ThemeModeTitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Native Windows Caption Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- Minimize -->
                    <Button Classes="caption-btn" Click="MinimizeWindow_Click" ToolTip.Tip="Minimize">
                        <PathIcon Width="10" Height="2" Foreground="{DynamicResource TextSecondaryBrush}" Data="M0,1 L10,1" />
                    </Button>
                    <!-- Maximize / Restore -->
                    <Button Classes="caption-btn" Click="MaximizeWindow_Click" ToolTip.Tip="Maximize">
                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M1,1 H9 V9 H1 Z" />
                    </Button>
                    <!-- Close -->
                    <Button Classes="caption-close-btn" Click="CloseWindow_Click" ToolTip.Tip="Close">
                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M1,1 L9,9 M9,1 L1,9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="210, *">
            <!-- ================= LEFT SIDEBAR ================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="0,0,1,0"
                    Padding="12,14">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Top Action Buttons -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="0,0,0,16">
                        <Button Grid.Column="0" Classes="primary-btn" Command="{Binding OpenAddModalCommand}" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="10" Height="10" Foreground="#FFFFFF" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                <TextBlock Text="Add" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Classes="subtle-btn" Command="{Binding PasteFromClipboardCommand}" Margin="3,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
                                <TextBlock Text="Paste" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Nav Links -->
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,6" />

                        <Button Classes="nav-link" Command="{Binding SelectFilterCommand}" CommandParameter="All">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="All Downloads" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding AllDownloads.Count}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Command="{Binding SelectFilterCommand}" CommandParameter="Downloading">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Active" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalActiveCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Command="{Binding SelectFilterCommand}" CommandParameter="Completed">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Completed" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalCompletedCount}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Command="{Binding SelectFilterCommand}" CommandParameter="Paused">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Paused" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Command="{Binding SelectFilterCommand}" CommandParameter="Failed">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Errors" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Status Text -->
                    <TextBlock Grid.Row="2" Text="Downloader.io" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT LIST ================= -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <!-- Search & Action Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppBgBrush}"
                        BorderBrush="{DynamicResource BorderBrushCustom}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid ColumnDefinitions="*, Auto">
                        <!-- Search Box -->
                        <TextBox Grid.Column="0"
                                 Classes="minimal-input"
                                 Text="{Binding SearchQuery}"
                                 Watermark="Search files..."
                                 MaxWidth="320"
                                 HorizontalAlignment="Left" />

                        <!-- Batch Action Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-btn" Command="{Binding ResumeAllCommand}" ToolTip.Tip="Resume All">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M8 5v14l11-7z" />
                                    <TextBlock Text="Resume All" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Button Classes="ghost-btn" Command="{Binding PauseAllCommand}" ToolTip.Tip="Pause All">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                    <TextBlock Text="Pause All" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Button Classes="ghost-btn" Command="{Binding ClearCompletedCommand}" ToolTip.Tip="Clear Completed">
                                <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Queue Items -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <ItemsControl ItemsSource="{Binding DisplayedDownloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DownloadItem">
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrushCustom}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,8"
                                            Padding="14,10">
                                        <Grid RowDefinitions="Auto, Auto, Auto">
                                            <!-- Top Row: File Name & Size -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>

                                            <!-- Middle Row: Minimal Progress Bar -->
                                            <ProgressBar Grid.Row="1"
                                                         Classes="thin-progress"
                                                         Value="{Binding ProgressPercentage}"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Margin="0,0,0,6" />

                                            <!-- Bottom Row: Metadata & Actions -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                                <!-- Metadata Line -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.#}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding StatusDisplayText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />

                                                    <!-- Live Speed -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding FormattedSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding FormattedSpeed}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <!-- ETA -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding FormattedEta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding FormattedEta}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <!-- Error msg -->
                                                    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" Foreground="#EF4444" />
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                    <!-- Pause -->
                                                    <Button Classes="ghost-btn" IsVisible="{Binding CanPause}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PauseDownloadCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Pause">
                                                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                                    </Button>

                                                    <!-- Resume -->
                                                    <Button Classes="ghost-btn" IsVisible="{Binding CanResume}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).StartDownloadCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Resume">
                                                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M8 5v14l11-7z" />
                                                    </Button>

                                                    <!-- Open File -->
                                                    <Button Classes="ghost-btn" IsVisible="{Binding IsCompleted}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenFileCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Open File">
                                                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
                                                    </Button>

                                                    <!-- Open Folder -->
                                                    <Button Classes="ghost-btn"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Show in Explorer">
                                                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                                    </Button>

                                                    <!-- Copy Link -->
                                                    <Button Classes="ghost-btn"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyUrlCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Copy Link">
                                                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                                    </Button>

                                                    <!-- Delete -->
                                                    <Button Classes="ghost-btn"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Delete">
                                                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Minimal Clean Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                IsVisible="{Binding !DisplayedDownloads.Count}">
                        <TextBlock Text="No active downloads" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Click '+ Add' or 'Paste' to start downloading a file." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= MINIMAL TOAST NOTIFICATION ================= -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasNotification}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrushCustom}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8">
            <TextBlock Text="{Binding QuickNotification}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <!-- ================= MINIMAL ADD DOWNLOAD MODAL ================= -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsAddModalOpen}"
                Background="{DynamicResource ModalOverlayBrush}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    DataContext="{Binding AddDialogVm}">
                <StackPanel Spacing="14">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Add Download" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding CancelCommand}" Padding="4">
                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </Button>
                    </Grid>

                    <!-- URL Input -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="URL Link(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding PasteFromClipboardCommand}" Padding="4,0">
                                <TextBlock Text="Paste from clipboard" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                            </Button>
                        </Grid>
                        <TextBox Classes="minimal-input"
                                 Text="{Binding UrlInput}"
                                 AcceptsReturn="True"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 Watermark="https://example.com/file.zip" />
                    </StackPanel>

                    <!-- File Name -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="File Name (optional):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Classes="minimal-input" Text="{Binding CustomFileName}" Watermark="Auto-detected from URL..." />
                    </StackPanel>

                    <!-- Save Directory -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Save Directory:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Classes="minimal-input" Text="{Binding SaveDirectory}" />
                    </StackPanel>

                    <!-- Start Immediately Checkbox -->
                    <CheckBox IsChecked="{Binding StartImmediately}" Content="Start downloading immediately" FontSize="11" />

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#EF4444" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding CancelCommand}" Content="Cancel" Margin="0,0,6,0" Padding="12,6" />
                        <Button Grid.Column="2" Classes="primary-btn" Command="{Binding ConfirmCommand}" Content="Download" Padding="14,6" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
