<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DownloaderApp.ViewModels"
        xmlns:models="using:DownloaderApp.Models"
        xmlns:controls="using:DownloaderApp.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        Width="1100" Height="720"
        MinWidth="860" MinHeight="540"
        x:Class="DownloaderApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource AppBgBrush}"
        TransparencyLevelHint="Mica,AcrylicBlur,Transparent"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Downloader.io">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="38, *" Background="{DynamicResource AppBgBrush}">
        <!-- ================= TOP WINDOWS CAPTION & TITLE BAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrushCustom}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <!-- App Title / Logo & Sidebar Toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Classes="ghost-btn" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle Sidebar (Expand / Collapse)" Padding="4">
                        <PathIcon Width="11" Height="11" Foreground="{DynamicResource TextSecondaryBrush}" Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                    </Button>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBlock Text="downloader.io" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Real-time Rolling Speed Waveform Chart (Clickable for Analytics) -->
                <Button Grid.Column="1"
                        Command="{Binding ToggleAnalyticsModalCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="18,2,18,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Cursor="Hand"
                        ToolTip.Tip="Click to view Real-time Network Analytics &amp; Performance Telemetry">
                    <Grid>
                        <controls:SpeedWaveformControl CurrentSpeed="{Binding CurrentAggregateSpeed}"
                                                       IsDarkMode="{Binding IsDarkMode}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       Opacity="0.85" />
                        <!-- Center Speed Readout Overlay -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                    IsVisible="{Binding TotalActiveCount}">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Classes="pulse-dot" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding TotalDownloadSpeedFormatted, StringFormat='{}↓ {0}'}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       VerticalAlignment="Center" />
                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalActiveCount, StringFormat='{}{0} active'}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Speed Limiter & Tools Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Speed Limiter Selector -->
                    <ComboBox SelectedIndex="{Binding SelectedSpeedCapIndex}"
                              FontSize="11"
                              Padding="6,3"
                              MaxHeight="26"
                              ToolTip.Tip="Bandwidth Throttling / Speed Limiter"
                              Background="{DynamicResource CardBgBrush}"
                              BorderBrush="{DynamicResource BorderBrushCustom}">
                        <ComboBoxItem Content="⚡ Unlimited" />
                        <ComboBoxItem Content="🐢 10 MB/s" />
                        <ComboBoxItem Content="🐢 5 MB/s" />
                        <ComboBoxItem Content="🐢 2 MB/s" />
                        <ComboBoxItem Content="🐢 500 KB/s" />
                    </ComboBox>

                    <!-- Floating Mini Widget Button -->
                    <Button Classes="ghost-btn" Command="{Binding ToggleMiniWidgetCommand}" ToolTip.Tip="Toggle Floating Drop Zone">
                        <PathIcon Width="11" Height="11" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
                    </Button>

                    <!-- Settings Button -->
                    <Button Classes="ghost-btn" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Settings">
                        <PathIcon Width="11" Height="11" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                    </Button>

                    <!-- Theme Switcher Button -->
                    <Button Classes="ghost-btn" Command="{Binding ToggleThemeCommand}" Padding="6,4" ToolTip.Tip="Toggle Theme">
                        <PathIcon Width="11" Height="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                  Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
                    </Button>
                </StackPanel>

                <!-- Native Windows Caption Controls (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Classes="caption-btn" Click="MinimizeWindow_Click" ToolTip.Tip="Minimize">
                        <Rectangle Width="10" Height="1.2" Fill="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="caption-btn" Click="MaximizeWindow_Click" ToolTip.Tip="Maximize">
                        <Border Width="10" Height="10" BorderBrush="{Binding $parent[Button].Foreground}" BorderThickness="1.2" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="caption-close-btn" Click="CloseWindow_Click" ToolTip.Tip="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.2"
                              Width="10" Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *">
            <!-- ================= LEFT SIDEBAR ================= -->
            <Border Grid.Column="0"
                    IsVisible="{Binding !IsSidebarCollapsed}"
                    Width="210"
                    MinWidth="160"
                    MaxWidth="380"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="0,0,1,0"
                    Padding="12,14">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Top Action Buttons -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="0,0,0,16">
                        <Button Grid.Column="0" Classes="primary-btn" Command="{Binding OpenAddModalCommand}" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="10" Height="10" Foreground="#FFFFFF" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                <TextBlock Text="Add" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Classes="subtle-btn" Command="{Binding PasteFromClipboardCommand}" Margin="3,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
                                <TextBlock Text="Paste" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Nav Links -->
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,6" />

                        <Button Classes="nav-link" Classes.active="{Binding IsAllSelected}" Command="{Binding SelectNavCommand}" CommandParameter="All">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z" />
                                    <TextBlock Text="All Downloads" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18">
                                    <TextBlock Text="{Binding TotalAllCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsActiveSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Downloading">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                                    <TextBlock Text="Active" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalActiveCount}">
                                    <TextBlock Text="{Binding TotalActiveCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsCompletedSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Completed">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
                                    <TextBlock Text="Completed" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalCompletedCount}">
                                    <TextBlock Text="{Binding TotalCompletedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsPausedSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Paused">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                    <TextBlock Text="Paused" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalPausedCount}">
                                    <TextBlock Text="{Binding TotalPausedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsFailedSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Failed">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                    <TextBlock Text="Errors" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalFailedCount}">
                                    <TextBlock Text="{Binding TotalFailedCount}" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,14,0,6" />

                        <Button Classes="nav-link" Classes.active="{Binding IsCompressedSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Compressed">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="📦 Archives / Zip" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalCompressedCount}">
                                    <TextBlock Text="{Binding TotalCompressedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsProgramsSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Programs">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="💻 Software &amp; Apps" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalProgramsCount}">
                                    <TextBlock Text="{Binding TotalProgramsCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsMediaSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Media">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="🎬 Videos &amp; Music" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalMediaCount}">
                                    <TextBlock Text="{Binding TotalMediaCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsDocumentsSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Documents">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="📄 Documents &amp; Data" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalDocumentsCount}">
                                    <TextBlock Text="{Binding TotalDocumentsCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav-link" Classes.active="{Binding IsOtherSelected}" Command="{Binding SelectNavCommand}" CommandParameter="Other">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="📁 Other Files" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="6,1" MinWidth="18" IsVisible="{Binding TotalOtherCount}">
                                    <TextBlock Text="{Binding TotalOtherCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Status Text -->
                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock Text="Ctrl+V to paste link" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Adjustable Width Grid Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="3"
                          IsVisible="{Binding !IsSidebarCollapsed}"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ShowsPreview="False" />

            <!-- ================= MAIN CONTENT LIST ================= -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <!-- Search & Action Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppBgBrush}"
                        BorderBrush="{DynamicResource BorderBrushCustom}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Expand Sidebar Button (when collapsed) -->
                        <Button Grid.Column="0"
                                Classes="ghost-btn"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="Expand Sidebar"
                                Padding="6,4"
                                Margin="0,0,8,0"
                                IsVisible="{Binding IsSidebarCollapsed}">
                            <PathIcon Width="11" Height="11" Foreground="{DynamicResource TextSecondaryBrush}" Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                        </Button>

                        <!-- Search Box -->
                        <TextBox Grid.Column="1"
                                 Classes="minimal-input"
                                 Text="{Binding SearchQuery}"
                                 Watermark="Search downloads..."
                                 MaxWidth="320"
                                 HorizontalAlignment="Left" />

                        <!-- Batch Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-btn" Command="{Binding ResumeAllCommand}" ToolTip.Tip="Resume All">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M8 5v14l11-7z" />
                                    <TextBlock Text="Resume All" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Button Classes="ghost-btn" Command="{Binding PauseAllCommand}" ToolTip.Tip="Pause All">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                    <TextBlock Text="Pause All" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Button Classes="ghost-btn" Command="{Binding ClearCompletedCommand}" ToolTip.Tip="Clear Completed">
                                <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Queue Items -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <ItemsControl ItemsSource="{Binding DisplayedDownloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DownloadItem">
                                    <Border Classes="download-card"
                                            Margin="0,0,0,8"
                                            Padding="14,10"
                                            ClipToBounds="True">
                                        <Grid>
                                            <!-- Live Reactive Block Progress Grid Background with Thread-Relative Matrix Positioning -->
                                            <controls:BlockProgressBackground
                                                Progress="{Binding ProgressPercentage}"
                                                IsActive="{Binding IsActive}"
                                                IsConnecting="{Binding IsConnecting}"
                                                IsIndeterminate="{Binding IsIndeterminate}"
                                                IsCompleted="{Binding IsCompleted}"
                                                IsFailed="{Binding IsFailed}"
                                                ErrorMessage="{Binding ErrorMessage}"
                                                PaletteIndex="{Binding PaletteIndex}"
                                                Segments="{Binding Segments}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Margin="-14,-10"
                                                IsHitTestVisible="False" />

                                            <!-- Foreground Download Card Content -->
                                            <Grid RowDefinitions="Auto, Auto, Auto">
                                                <!-- Top Row: File Name, Scenario Badge & Size -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsActive}" Classes="pulse-dot" />
                                                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <!-- Thread Badge -->
                                                        <Border IsVisible="{Binding Segments.Count}" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="5,1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding Segments.Count, StringFormat='{}{0} Threads'}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                        <!-- Failure Scenario Diagnostic Badge -->
                                                        <Border IsVisible="{Binding IsFailed}"
                                                                Background="#25EF4444"
                                                                BorderBrush="#60EF4444"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="4,0,0,0"
                                                                ToolTip.Tip="{Binding ErrorMessage}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding ScenarioDiagnosticIcon}" FontSize="10" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ScenarioDiagnosticText}" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" MinWidth="110" TextAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>

                                                <!-- Middle Row: Minimal Progress Bar -->
                                                <ProgressBar Grid.Row="1"
                                                             Classes="thin-progress"
                                                             IsIndeterminate="{Binding IsIndeterminate}"
                                                             Value="{Binding ProgressPercentage}"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Margin="0,0,0,6" />

                                                <!-- Bottom Row: Metadata & Actions -->
                                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                                    <!-- Metadata Line with Stable Fixed Boundaries -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Progress Percentage -->
                                                        <TextBlock Text="{Binding FormattedPercentageText}"
                                                                   Width="44"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Status -->
                                                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusDisplayText}"
                                                                   MinWidth="80"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Live Speed -->
                                                        <StackPanel Orientation="Horizontal" IsVisible="{Binding FormattedSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FormattedSpeed}"
                                                                       MinWidth="85"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- ETA -->
                                                        <StackPanel Orientation="Horizontal" IsVisible="{Binding FormattedEta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FormattedEta}"
                                                                       MinWidth="95"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                        <!-- Quick Retry Button on Error -->
                                                        <Button Classes="primary-btn"
                                                                IsVisible="{Binding IsFailed}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).StartDownloadCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Retry Connection"
                                                                Padding="7,3"
                                                                Margin="0,0,4,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon Width="9" Height="9" Foreground="#FFFFFF" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                                                                <TextBlock Text="Retry" FontSize="10" FontWeight="Bold" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Inspector / Details Button -->
                                                        <Button Classes="ghost-btn"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenInspectorCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Inspect Threads &amp; Details">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
                                                        </Button>

                                                        <!-- Pause -->
                                                        <Button Classes="ghost-btn" IsVisible="{Binding CanPause}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PauseDownloadCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Pause">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                                        </Button>

                                                        <!-- Resume -->
                                                        <Button Classes="ghost-btn" IsVisible="{Binding CanResume}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).StartDownloadCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Resume">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M8 5v14l11-7z" />
                                                        </Button>

                                                        <!-- Open File -->
                                                        <Button Classes="ghost-btn" IsVisible="{Binding IsCompleted}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenFileCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Open File">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
                                                        </Button>

                                                        <!-- Open Folder -->
                                                        <Button Classes="ghost-btn"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Show in Explorer">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                                        </Button>

                                                        <!-- Copy Link -->
                                                        <Button Classes="ghost-btn"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyUrlCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Copy Link">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                                        </Button>

                                                        <!-- Delete -->
                                                        <Button Classes="ghost-btn"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteDownloadCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Delete">
                                                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                IsVisible="{Binding !DisplayedDownloads.Count}">
                        <TextBlock Text="No active downloads" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Press Ctrl+V to paste link from clipboard or click '+ Add'." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= INSPECTOR DRAWER ================= -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsInspectorOpen}"
                Background="{DynamicResource ModalOverlayBrush}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="640"
                    MaxHeight="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Download Inspector &amp; Thread Map" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding InspectedItem.FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding CloseInspectorCommand}" Padding="4">
                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </Button>
                    </Grid>

                    <!-- Tab Switcher -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Margin="0,0,0,14">
                        <Button Grid.Column="0" Classes="subtle-btn" Command="{Binding SelectInspectorTabCommand}" CommandParameter="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
                            <TextBlock Text="Threads Matrix" FontSize="11" />
                        </Button>
                        <Button Grid.Column="1" Classes="subtle-btn" Command="{Binding SelectInspectorTabCommand}" CommandParameter="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,3,0">
                            <TextBlock Text="Checksum Verifier" FontSize="11" />
                        </Button>
                        <Button Grid.Column="2" Classes="subtle-btn" Command="{Binding SelectInspectorTabCommand}" CommandParameter="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
                            <TextBlock Text="Headers &amp; Info" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Content Tab Area -->
                    <Grid Grid.Row="2">
                        <!-- Tab 0: Detailed Thread Visualizer & Position Info -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" IsVisible="{Binding IsTab0}">
                            <StackPanel Spacing="10">
                                <!-- Concurrency Summary Card -->
                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="12,8">
                                    <Grid ColumnDefinitions="*, *, *">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="CONCURRENCY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding InspectedItem.Segments.Count, StringFormat='{}{0} Parallel Threads'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="TOTAL RANGE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding InspectedItem.FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="OVERALL SPEED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding InspectedItem.FormattedSpeed}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Individual Thread Cards -->
                                <ItemsControl ItemsSource="{Binding InspectedItem.Segments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:DownloadSegment">
                                            <Border Background="{DynamicResource ChipBgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushCustom}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid RowDefinitions="Auto, Auto, Auto">
                                                    <!-- Row 0: Thread Header & Live State -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,6">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="5,2">
                                                                <TextBlock Text="{Binding SegmentId, StringFormat='{}THREAD #{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedProgress}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSpeed}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <!-- Row 1: High-Tech Progress Bar -->
                                                    <ProgressBar Grid.Row="1" Classes="thin-progress" Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Margin="0,0,0,6" />

                                                    <!-- Row 2: Detailed Start Point, Offset, and End Point -->
                                                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                                                            <TextBlock Text="Start:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding FormattedStartPoint}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                                            <TextBlock Text="Offset:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding FormattedCurrentOffset}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                                            <TextBlock Text="End:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding FormattedEndPoint}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Single stream mode active (server did not supply range segments)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !InspectedItem.Segments.Count}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab 1: Checksum verification -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsTab1}">
                            <TextBlock Text="Cryptographic Hash Verification" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <Grid ColumnDefinitions="Auto, *">
                                <ComboBox Grid.Column="0" SelectedItem="{Binding ChecksumAlgorithm}" SelectedIndex="0" MaxHeight="30" FontSize="11" Margin="0,0,8,0">
                                    <ComboBoxItem Content="SHA256" />
                                    <ComboBoxItem Content="MD5" />
                                </ComboBox>
                                <Button Grid.Column="1" Classes="primary-btn" Command="{Binding ComputeChecksumCommand}" Content="Compute Hash" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Calculated File Hash:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="minimal-input" Text="{Binding CalculatedChecksum}" IsReadOnly="True" FontSize="11" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Compare against expected hash:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding PasteExpectedChecksumCommand}" Padding="4,0">
                                        <TextBlock Text="Paste from clipboard" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                </Grid>
                                <TextBox Classes="minimal-input" Text="{Binding ExpectedChecksumInput}" Watermark="Paste MD5 / SHA-256 hash here..." FontSize="11" />
                            </StackPanel>
                            <!-- Match Indicator -->
                            <Border IsVisible="{Binding ChecksumMatchStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding ChecksumMatchStatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Tab 2: Headers & Info -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" IsVisible="{Binding IsTab2}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Source URL:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox Classes="minimal-input" Text="{Binding InspectedItem.Url}" IsReadOnly="True" FontSize="10" TextWrapping="Wrap" />

                                <TextBlock Text="Destination Path:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                <TextBox Classes="minimal-input" Text="{Binding InspectedItem.FullPath}" IsReadOnly="True" FontSize="10" TextWrapping="Wrap" />

                                <TextBlock Text="Server Info:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                <TextBox Classes="minimal-input" Text="{Binding InspectedItem.ServerHeadersSummary}" IsReadOnly="True" FontSize="10" />

                                <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Created:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding InspectedItem.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Completed:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding InspectedItem.CompletedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer -->
                    <Button Grid.Row="3" Classes="subtle-btn" Command="{Binding CloseInspectorCommand}" Content="Close Inspector" HorizontalAlignment="Right" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Border>

        <!-- ================= SETTINGS DRAWER ================= -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsSettingsOpen}"
                Background="{DynamicResource ModalOverlayBrush}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Settings &amp; Preferences" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding ToggleSettingsCommand}" Padding="4">
                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </Button>
                    </Grid>

                    <!-- Default Folder -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Default Download Directory:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Classes="minimal-input" Text="{Binding DefaultDownloadDirectory}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Classes="subtle-btn" Command="{Binding BrowseDefaultDirectoryCommand}" Content="Browse..." Padding="10,6" />
                        </Grid>
                    </StackPanel>

                    <!-- Options Grid -->
                    <StackPanel Spacing="8">
                        <CheckBox IsChecked="{Binding IsSmartFolderRoutingEnabled}" Content="Smart Folder Routing (Auto-sort Archives, Media, Software)" FontSize="11" />
                        <CheckBox IsChecked="{Binding IsAutoExtractZipEnabled}" Content="Auto-Extract ZIP archives upon download completion" FontSize="11" />
                        <CheckBox IsChecked="{Binding IsClipboardSnifferEnabled}" Content="Clipboard Sniffer (Prompt when downloadable links are copied)" FontSize="11" />
                        <CheckBox IsChecked="{Binding IsSoundEnabled}" Content="Play subtle sound cues on download complete / error" FontSize="11" />
                    </StackPanel>

                    <!-- Power Actions -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Post-Download Power Management (When all downloads finish):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox SelectedIndex="{Binding SelectedPostDownloadActionIndex}" FontSize="11" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="None (Stay On)" />
                            <ComboBoxItem Content="Shut Down PC" />
                            <ComboBoxItem Content="Sleep Mode" />
                            <ComboBoxItem Content="Hibernate" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Browser Emulation & User-Agent Profile -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Browser Emulation &amp; User-Agent Profile:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox SelectedIndex="{Binding SelectedUserAgentPresetIndex}" FontSize="11" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="🌐 Google Chrome 128 (Windows 11) [Recommended]" />
                            <ComboBoxItem Content="🦊 Mozilla Firefox 130 (Windows 11)" />
                            <ComboBoxItem Content="🌊 Microsoft Edge 128 (Windows 11)" />
                            <ComboBoxItem Content="🍎 Apple Safari 17.5 (macOS)" />
                            <ComboBoxItem Content="📱 Google Chrome Mobile (Android 14)" />
                            <ComboBoxItem Content="⚡ Downloader.io Native Engine 2.0" />
                            <ComboBoxItem Content="⚙️ Custom User-Agent String..." />
                        </ComboBox>
                        <TextBox Classes="minimal-input"
                                 Text="{Binding CustomUserAgent}"
                                 Watermark="Enter custom User-Agent string (e.g. Mozilla/5.0...)"
                                 FontSize="11"
                                 Margin="0,4,0,0"
                                 IsVisible="{Binding IsCustomUserAgent}" />
                    </StackPanel>

                    <!-- Save Actions -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,6,0,0">
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding ToggleSettingsCommand}" Content="Cancel" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Classes="primary-btn" Command="{Binding SaveSettingsCommand}" Content="Save Settings" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= MINIMAL TOAST NOTIFICATION ================= -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasNotification}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrushCustom}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8">
            <TextBlock Text="{Binding QuickNotification}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <!-- ================= ADD DOWNLOAD MODAL ================= -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsAddModalOpen}"
                Background="{DynamicResource ModalOverlayBrush}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22"
                    DataContext="{Binding AddDialogVm}">
                <StackPanel Spacing="12">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Add Download Task" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding CancelCommand}" Padding="4">
                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </Button>
                    </Grid>

                    <!-- URL Input -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="URL Link(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding PasteFromClipboardCommand}" Padding="4,0">
                                <TextBlock Text="Paste from clipboard" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                            </Button>
                        </Grid>
                        <TextBox Classes="minimal-input"
                                 Text="{Binding UrlInput}"
                                 AcceptsReturn="True"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 Watermark="https://example.com/file.zip" />
                    </StackPanel>

                    <!-- File Details Container -->
                    <Grid MinHeight="75">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="File Name:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="minimal-input" Text="{Binding CustomFileName}" Watermark="Auto-detected file name..." />
                            </StackPanel>

                            <!-- Fetched Server Metadata Card Grid -->
                            <Border IsVisible="{Binding HasDetectedInfo}"
                                    Background="{DynamicResource ChipBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushCustom}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*, *, *, *" DataContext="{Binding CurrentMetadata}">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="SIZE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="TYPE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding DisplayType}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="RESUMABLE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding ResumableText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock Text="HOST" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Domain}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Scanning Overlay -->
                        <Border IsVisible="{Binding IsFetchingMetadata}"
                                Background="{DynamicResource GlassOverlayBgBrush}"
                                BorderBrush="{DynamicResource GlassOverlayBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Probing server headers..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <ProgressBar Classes="scanner-bar" Width="140" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Save Directory -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Save Directory:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Classes="minimal-input" Text="{Binding SaveDirectory}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Classes="subtle-btn" Command="{Binding BrowseFolderCommand}" Padding="10,6" Content="Browse..." />
                        </Grid>
                    </StackPanel>

                    <!-- Parallel Acceleration Threads & Options -->
                    <Grid ColumnDefinitions="*, *">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Parallel Threads:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableThreadCounts}" SelectedItem="{Binding SelectedThreadCount}" FontSize="11" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="6,0,0,0">
                            <CheckBox IsChecked="{Binding AutoExtractZip}" Content="Auto-extract ZIP archive" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- Start Immediately & Dynamic Schedule Sub-Panel -->
                    <StackPanel Spacing="6">
                        <CheckBox IsChecked="{Binding StartImmediately}" Content="Start downloading immediately" FontSize="11" />

                        <!-- Dynamic Schedule Time Panel (Only visible when not starting immediately) -->
                        <Border IsVisible="{Binding !StartImmediately}"
                                Background="{DynamicResource ChipBgBrush}"
                                BorderBrush="{DynamicResource BorderBrushCustom}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,2,0,0">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsScheduled}" Content="Schedule Start Time:" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Classes="minimal-input" Text="{Binding ScheduledTimeString}" IsEnabled="{Binding IsScheduled}" Watermark="HH:mm (e.g. 02:00)" FontSize="11" HorizontalAlignment="Stretch" />
                                <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsScheduled}">
                                    <TextBlock Text="Timer Set" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding CancelCommand}" Content="Cancel" Margin="0,0,6,0" Padding="12,6" />
                        <Button Grid.Column="2" Classes="primary-btn" Command="{Binding ConfirmCommand}" Content="Download" Padding="14,6" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= ANALYTICS & NETWORK TELEMETRY MODAL ================= -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsAnalyticsModalOpen}"
                Background="{DynamicResource ModalOverlayBrush}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="620"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <StackPanel Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Classes="pulse-dot" />
                                <TextBlock Text="Live Network Analytics &amp; Telemetry" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Real-time multi-threaded bandwidth throughput &amp; engine diagnostics" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost-btn" Command="{Binding CloseAnalyticsModalCommand}" Padding="4">
                            <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                        </Button>
                    </Grid>

                    <!-- High-Resolution Real-time Speed Waveform -->
                    <Border Background="{DynamicResource ChipBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Height="140">
                        <Grid>
                            <controls:SpeedWaveformControl CurrentSpeed="{Binding CurrentAggregateSpeed}"
                                                           IsDarkMode="{Binding IsDarkMode}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- 4-Card Primary KPI Metrics Grid -->
                    <Grid ColumnDefinitions="*, *, *, *">
                        <Border Grid.Column="0" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,3,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CURRENT SPEED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalDownloadSpeedFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="PEAK SPEED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding FormattedPeakSpeed}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="AVERAGE RATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding FormattedAverageSpeed}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="10,8" Margin="3,0,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="TRANSFERRED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding FormattedTotalTransferred}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Diagnostic Telemetry Details Panel -->
                    <Border Background="{DynamicResource ChipBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ENGINE DIAGNOSTICS &amp; HARDWARE TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Column="0" Text="Session Uptime:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Width="120" />
                                        <TextBlock Grid.Column="1" Text="{Binding SessionDurationFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Column="0" Text="Active Worker Threads:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Width="120" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveConnectionsCount, StringFormat='{}{0} Concurrency Streams'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Column="0" Text="Multi-Segment Engine:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Width="130" />
                                        <TextBlock Grid.Column="1" Text="Adaptive Slicing Active" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Column="0" Text="Checkpoint Resumption:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Width="130" />
                                        <TextBlock Grid.Column="1" Text="Atomic Sidecar Sync" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Modal Actions Footer -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                        <Button Grid.Column="0" Classes="ghost-btn" Command="{Binding ResetSessionStatsCommand}" Padding="8,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                                <TextBlock Text="Reset Counters" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="subtle-btn" Command="{Binding CloseAnalyticsModalCommand}" Content="Done" Padding="18,6" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
