<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownloaderApp.App"
             xmlns:local="using:DownloaderApp"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- MINIMAL LIGHT PALETTE -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBgBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="SidebarBgBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="BorderBrushCustom" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="BorderHoverBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E5E9F0" />
                    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#0284C7" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.5" />
                        <GradientStop Color="#4F46E5" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="CaptionBtnHoverBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="GlassOverlayBgBrush" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="GlassOverlayBorderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="ChipBgBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="TileGridEmptyBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="TileGridFilledBrush" Color="#222563EB" />
                    <SolidColorBrush x:Key="TileGridFilledBorderBrush" Color="#442563EB" />
                    <SolidColorBrush x:Key="TileGridActiveHeadBrush" Color="#662563EB" />
                </ResourceDictionary>

                <!-- MINIMAL LCD DARK PALETTE -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBgBrush" Color="#0B0C0E" />
                    <SolidColorBrush x:Key="SidebarBgBrush" Color="#101114" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#1B1D23" />
                    <SolidColorBrush x:Key="BorderBrushCustom" Color="#20222A" />
                    <SolidColorBrush x:Key="BorderHoverBrush" Color="#333846" />
                    <SolidColorBrush x:Key="InputBgBrush" Color="#121317" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#555A66" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#131F37" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#181B22" />
                    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#06B6D4" Offset="0.0" />
                        <GradientStop Color="#3B82F6" Offset="0.5" />
                        <GradientStop Color="#6366F1" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="CaptionBtnHoverBrush" Color="#20232C" />
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="GlassOverlayBgBrush" Color="#F2101217" />
                    <SolidColorBrush x:Key="GlassOverlayBorderBrush" Color="#222530" />
                    <SolidColorBrush x:Key="ChipBgBrush" Color="#181B22" />
                    <SolidColorBrush x:Key="TileGridEmptyBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="TileGridFilledBrush" Color="#263B82F6" />
                    <SolidColorBrush x:Key="TileGridFilledBorderBrush" Color="#553B82F6" />
                    <SolidColorBrush x:Key="TileGridActiveHeadBrush" Color="#9938BDF8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Base Button Reset -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Minimal Primary Button with Transitions -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Minimal Outline / Subtle Button with Transitions -->
        <Style Selector="Button.subtle-btn">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.subtle-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.subtle-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Minimal Ghost Button -->
        <Style Selector="Button.ghost-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ghost-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Download Card Style with Hover Lift & Border Glow -->
        <Style Selector="Border.download-card">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.download-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>

        <!-- Windows Title Bar Caption Buttons (Minimize, Maximize) -->
        <Style Selector="Button.caption-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.caption-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CaptionBtnHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.caption-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrushCustom}" />
        </Style>

        <!-- Windows Title Bar Close Button (Red on Hover) -->
        <Style Selector="Button.caption-close-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.caption-close-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.caption-close-btn:pointerover Path">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.caption-close-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C4101E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Minimal Sidebar Nav Item -->
        <Style Selector="Button.nav-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Minimal Input Box with Transitions -->
        <Style Selector="TextBox.minimal-input">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.minimal-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
        </Style>

        <!-- Liquid Smooth ProgressBar -->
        <Style Selector="ProgressBar.thin-progress">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ProgressFillBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ProgressBar.thin-progress /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ProgressBar.thin-progress /template/ Border#PART_Track">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Pulsing Indicator Animation -->
        <Style Selector="Ellipse.pulse-dot">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.4" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.4" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Scanner Line Animation -->
        <Style Selector="ProgressBar.scanner-bar">
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Styles>
</Application>
