<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownloaderApp.App"
             xmlns:local="using:DownloaderApp"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- MINIMAL LIGHT PALETTE -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBgBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="SidebarBgBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="BorderBrushCustom" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ProgressFillBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="CaptionBtnHoverBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
                    <SolidColorBrush x:Key="CaptionCloseFgBrush" Color="#111827" />
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#66000000" />
                </ResourceDictionary>

                <!-- MINIMAL LCD DARK PALETTE (Matte, High-Contrast, Zero-Glow) -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBgBrush" Color="#0B0C0E" />
                    <SolidColorBrush x:Key="SidebarBgBrush" Color="#101114" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#1B1D23" />
                    <SolidColorBrush x:Key="BorderBrushCustom" Color="#20222A" />
                    <SolidColorBrush x:Key="InputBgBrush" Color="#121317" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#555A66" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#131F37" />
                    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#20222A" />
                    <SolidColorBrush x:Key="ProgressFillBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="CaptionBtnHoverBrush" Color="#1F222B" />
                    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
                    <SolidColorBrush x:Key="CaptionCloseFgBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B3000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Base Button Reset -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Minimal Primary Button -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Minimal Outline / Subtle Button -->
        <Style Selector="Button.subtle-btn">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.subtle-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Minimal Ghost Button -->
        <Style Selector="Button.ghost-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.ghost-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Windows Title Bar Caption Buttons -->
        <Style Selector="Button.caption-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CaptionBtnHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Caption Close Button (Red Hover) -->
        <Style Selector="Button.caption-close-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption-close-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Minimal Sidebar Nav Item -->
        <Style Selector="Button.nav-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Minimal Input Box -->
        <Style Selector="TextBox.minimal-input">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox.minimal-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
        </Style>

        <!-- Minimal Thin ProgressBar -->
        <Style Selector="ProgressBar.thin-progress">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ProgressFillBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Styles>
</Application>
